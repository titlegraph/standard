{
  "lexicon": 1,
  "id": "org.titlegraph.catalog.core",
  "defs": {
    "metadata": {
      "type": "object",
      "description": "Foundational metadata shared across all TitleGraph media assets.",
      "required": [
        "title",
        "productionStatus"
      ],
      "properties": {
        "canonicalRef": {
          "type": "string",
          "format": "at-uri",
          "description": "Optional AT-URI pointing to the canonical parent catalog record (e.g., on @filmograph.io) that this spoke record overlays or enriches."
        },
        "title": {
          "type": "string",
          "maxLength": 500,
          "description": "Matches schema.org/name. The primary display title."
        },
        "originalTitle": {
          "type": "string",
          "maxLength": 500,
          "description": "The original title in the work's native language (Wikidata P1476)."
        },
        "description": {
          "type": "string",
          "maxLength": 10000,
          "description": "Matches schema.org/description. The primary plot summary."
        },
        "localizedDescriptions": {
          "type": "array",
          "description": "Translated plot summaries or loglines keyed by BCP 47 language tag.",
          "items": {
            "type": "ref",
            "ref": "#localizedText"
          }
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Matches schema.org/url. The primary web/app destination to view this title."
        },
        "synopsis": {
          "type": "string",
          "maxLength": 1000,
          "description": "Matches schema.org/abstract. A short logline."
        },
        "releaseYear": {
          "type": "integer",
          "description": "The year of initial global release."
        },
        "releaseDate": {
          "type": "string",
          "format": "datetime",
          "description": "ISO 8601 initial release date."
        },
        "countriesOfOrigin": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 10
          },
          "description": "ISO 3166-1 alpha-2 country codes of origin (e.g., ['US', 'ZA'])."
        },
        "contentRating": {
          "type": "string",
          "description": "Matches schema.org/contentRating (e.g., PG-13, TV-MA)."
        },
        "genres": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Matches schema.org/genre."
        },
        "eidr": {
          "type": "string",
          "description": "The Entertainment Identifier Registry (EIDR) ID."
        },
        "proprietaryIds": {
          "type": "array",
          "description": "An array of internal system IDs (e.g., Wikidata, IMDb, TMDB, Gracenote).",
          "items": {
            "type": "ref",
            "ref": "#proprietaryId"
          }
        },
        "technicalSpecs": {
          "type": "ref",
          "ref": "#technicalSpecs",
          "description": "Consolidated technical specifications, linguistic options, and accessibility features available for the media."
        },
        "imagePortrait": {
          "type": "blob",
          "accept": [
            "image/jpeg",
            "image/png",
            "image/webp"
          ],
          "description": "Primary 2:3 or 3:4 key art."
        },
        "imagePortraitUrl": {
          "type": "string",
          "format": "uri",
          "description": "External URI for primary 2:3 or 3:4 key art."
        },
        "imageLandscape": {
          "type": "blob",
          "accept": [
            "image/jpeg",
            "image/png",
            "image/webp"
          ],
          "description": "Primary 16:9 hero artwork."
        },
        "imageLandscapeUrl": {
          "type": "string",
          "format": "uri",
          "description": "External URI for primary 16:9 hero artwork."
        },
        "imageBackground": {
          "type": "blob",
          "accept": [
            "image/jpeg",
            "image/png",
            "image/webp"
          ],
          "description": "Textless 16:9 background art."
        },
        "imageBackgroundUrl": {
          "type": "string",
          "format": "uri",
          "description": "External URI for textless 16:9 background art."
        },
        "titleTreatment": {
          "type": "blob",
          "accept": [
            "image/png",
            "image/webp"
          ],
          "description": "Transparent logo artwork."
        },
        "titleTreatmentUrl": {
          "type": "string",
          "format": "uri",
          "description": "External URI for transparent logo artwork."
        },
        "productionStatus": {
          "type": "string",
          "enum": [
            "pitch",
            "script",
            "development",
            "pre-production",
            "production",
            "post-production",
            "completed",
            "released"
          ]
        },
        "seeking": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 50
          },
          "description": "e.g., ['distribution', 'funding', 'cast']"
        },
        "pitchMaterialsUrl": {
          "type": "string",
          "format": "uri",
          "description": "Secure link to a deck, script, or screener."
        },
        "credits": {
          "type": "array",
          "items": {
            "type": "ref",
            "ref": "#creditItem"
          }
        }
      }
    },
    "localizedText": {
      "type": "object",
      "required": [
        "lang",
        "text"
      ],
      "properties": {
        "lang": {
          "type": "string",
          "maxLength": 20,
          "description": "BCP 47 language code (e.g., 'en-ZA', 'zu', 'af')."
        },
        "text": {
          "type": "string",
          "maxLength": 10000
        }
      }
    },
    "creditItem": {
      "type": "object",
      "required": [
        "role",
        "name"
      ],
      "properties": {
        "role": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "character": {
          "type": "string",
          "maxLength": 300,
          "description": "Character name if role is Cast/Actor (Wikidata P453 / P4633)."
        },
        "order": {
          "type": "integer",
          "description": "Billing order (Wikidata P1545)."
        },
        "did": {
          "type": "string",
          "format": "did",
          "description": "Links the credit to an AT Proto user."
        },
        "proprietaryIds": {
          "type": "array",
          "description": "External registry IDs for this person (e.g., IMDb nm ID, Wikidata Q-ID).",
          "items": {
            "type": "ref",
            "ref": "#proprietaryId"
          }
        }
      }
    },
    "proprietaryId": {
      "type": "object",
      "required": [
        "system",
        "id"
      ],
      "properties": {
        "system": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      }
    },
    "technicalSpecs": {
      "type": "object",
      "properties": {
        "resolutions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "aspectRatios": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "primaryLanguages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dubbedLanguages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "subtitleLanguages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "accessibilityFeatures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}